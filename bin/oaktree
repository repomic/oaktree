#!/usr/bin/env php
<?php

$findProjectRoot = static function (): ?string {
    $directories = [getcwd(), dirname(__DIR__)];

    foreach ($directories as $directory) {
        while ($directory !== dirname($directory)) {
            if (is_file($directory . '/vendor/autoload.php')) {
                return $directory;
            }

            if (basename($directory) === 'vendor' && is_file($directory . '/autoload.php')) {
                return dirname($directory);
            }

            $directory = dirname($directory);
        }
    }

    return null;
};

$root = $findProjectRoot();

if ($root === null) {
    fwrite(STDERR, "Unable to locate the Composer project (vendor/autoload.php not found).\n");

    exit(1);
}

require $root . '/vendor/autoload.php';

use Oaktree\Compiler;
use Oaktree\CssCompressor;
use Oaktree\Extractor;
use Oaktree\RuleLoader;

$watch = in_array('--watch', $argv, true) || in_array('-w', $argv, true);
$watchPaths = array_values(array_filter([
    $root . '/resources/views',
    $root . '/resources/js',
    $root . '/storage/framework/views',
]));
$extensions = ['php', 'blade.php', 'vue', 'js', 'html'];
$extractor = new Extractor;
$compressor = new CssCompressor;
$compiler = new Compiler(...(new RuleLoader()->getRules()));

$build = static function () use ($root, $watchPaths, $extensions, $extractor, $compressor, $compiler): void {
    $tokens = $extractor->scan($watchPaths, $extensions);
    $cssFiles = [
        $root . '/resources/css/normalize.css',
        $root . '/resources/css/base.css',
    ];
    $css = [];

    foreach ($cssFiles as $file) {
        if (is_file($file)) {
            $css[] = file_get_contents($file);
        }
    }

    $css[] = $compiler->compile($tokens);
    $outputPath = $root . '/public/css/oaktree.css';
    $output = implode("\n", array_filter($css));

    if (getenv('APP_ENV') === 'production') {
        $output = $compressor->compress($output);
    }

    if (!is_dir(dirname($outputPath))) {
        mkdir(dirname($outputPath), 0777, true);
    }

    file_put_contents($outputPath, $output);
    fwrite(STDOUT, "Compiled CSS to {$outputPath}\n");
};

$lastState = [];
$firstRun = true;

do {
    try {
        $state = $extractor->getDirectoryState($watchPaths, $extensions);

        if ($state !== $lastState) {
            fwrite(STDOUT, '[' . date('H:i:s') . '] Rebuilding CSS...\n');
            $start = microtime(true);
            $build();
            $elapsed = round((microtime(true) - $start) * 1000, 2);
            fwrite(STDOUT, "Done in {$elapsed}ms.\n");
            $lastState = $state;

            if ($watch && $firstRun) {
                fwrite(STDOUT, "Watching for file changes... (Press Ctrl+C to stop)\n");
            }
        }
    } catch (Throwable $exception) {
        fwrite(STDERR, "Build failed: {$exception->getMessage()}\n");

        if (!$watch) {
            exit(1);
        }

        $lastState = $state ?? $lastState;
    }

    $firstRun = false;

    if ($watch) {
        usleep(500000);
    }
} while ($watch);

exit(0);
